<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="FullScreenAlarm.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:local="using:FullScreenAlarm"
    mc:Ignorable="d"
    Title="アラーム">

    <Grid x:Name="Root">

        <!-- 設定画面: 通常ウィンドウで表示 -->
        <Grid x:Name="SettingsPanel" Padding="24" RowSpacing="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Spacing="2" HorizontalAlignment="Center">
                <TextBlock x:Name="ClockText"
                           Text="00:00:00"
                           FontSize="56"
                           FontWeight="Light"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="DateText"
                           FontSize="16"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="AlarmStatusText"
                           FontSize="16"
                           Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <ListView x:Name="AlarmList"
                      Grid.Row="1"
                      SelectionMode="None"
                      IsItemClickEnabled="True"
                      ItemClick="AlarmList_ItemClick">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:AlarmRow">
                        <Grid Padding="4,8" ColumnSpacing="16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{x:Bind TimeText}"
                                       FontSize="32"
                                       VerticalAlignment="Center"/>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind RepeatText}"/>
                                <TextBlock Text="{x:Bind Label}"
                                           FontSize="12"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <CheckBox Grid.Column="2"
                                      Content="有効"
                                      MinWidth="0"
                                      Tag="{x:Bind Rule}"
                                      IsChecked="{x:Bind IsEnabled}"
                                      Click="Row_Click"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <StackPanel Grid.Row="2" Spacing="4" HorizontalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="24" HorizontalAlignment="Center">
                    <Button x:Name="AddButton"
                            Content="＋ アラームを追加"
                            Click="AddButton_Click"/>
                    <ToggleSwitch x:Name="AutoStartToggle"
                                  OnContent="自動スタート: オン"
                                  OffContent="自動スタート: オフ"
                                  Toggled="AutoStartToggle_Toggled"/>
                </StackPanel>
                <TextBlock x:Name="AutoStartHint"
                           FontSize="12"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- 鳴動画面: 全画面で表示される -->
        <Grid x:Name="RingPanel"
              Visibility="Collapsed">
            <Grid.Background>
                <SolidColorBrush x:Name="RingBrush" Color="#B71C1C"/>
            </Grid.Background>

            <!-- 背景を赤 ⇄ 黒でゆっくり行き来させる(片道1秒、往復2秒) -->
            <Grid.Resources>
                <Storyboard x:Name="RingPulse">
                    <ColorAnimation Storyboard.TargetName="RingBrush"
                                    Storyboard.TargetProperty="Color"
                                    From="#B71C1C"
                                    To="#000000"
                                    Duration="0:0:1"
                                    AutoReverse="True"
                                    RepeatBehavior="Forever">
                        <ColorAnimation.EasingFunction>
                            <SineEase EasingMode="EaseInOut"/>
                        </ColorAnimation.EasingFunction>
                    </ColorAnimation>
                </Storyboard>
            </Grid.Resources>

            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Spacing="40">
                <TextBlock Text="アラーム"
                           FontSize="96"
                           FontWeight="Bold"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="RingTimeText"
                           FontSize="64"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <TextBlock x:Name="RingLabelText"
                           FontSize="36"
                           Foreground="White"
                           HorizontalAlignment="Center"/>
                <StackPanel Orientation="Horizontal"
                            Spacing="32"
                            HorizontalAlignment="Center">
                    <Button x:Name="SnoozeButton"
                            Content="スヌーズ (5分)"
                            FontSize="32"
                            Padding="40,20"
                            Click="SnoozeButton_Click"/>
                    <Button x:Name="StopButton"
                            Content="停止"
                            FontSize="32"
                            Padding="40,20"
                            Click="StopButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>

    </Grid>
</Window>
